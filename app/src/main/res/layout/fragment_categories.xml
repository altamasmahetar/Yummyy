<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categories"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#6A35A8" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCatPizza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🍕 Pizza"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A35A8" />

            <Button
                android:id="@+id/btnCatBurger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🍔 Burgers"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A35A8" />

            <Button
                android:id="@+id/btnCatChinese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🍜 Chinese"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A35A8" />

            <Button
                android:id="@+id/btnCatDesserts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🍰 Desserts"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A35A8" />

            <Button
                android:id="@+id/btnCatBeverages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🥤 Beverages"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A35A8" />

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvSelectedCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Pizza Items"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/categoryProductsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>